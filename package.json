{
  "name": "dsh-oss-sync",
  "version": "0.2.0",
  "description": "Sync DeepSeek Harness 0.1.7+ settings and credentials through an S3-compatible bucket, with a Plugins-page configuration section",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./settings": {
      "types": "./lib/settings.d.ts",
      "default": "./lib/settings.js"
    },
    "./credentials": {
      "types": "./lib/credentials.d.ts",
      "default": "./lib/credentials.js"
    },
    "./package.json": "./package.json",
    "./client": {
      "default": "./lib/client.js"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.client.json && node scripts/build-client.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\"",
    "install:profiles": "node scripts/install.mjs",
    "smoke": "node test/smoke.mjs",
    "test:card": "node test/card.mjs",
    "prepublishOnly": "pnpm build",
    "test": "node test/smoke.mjs && node test/card.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1131.0",
    "@aws-sdk/credential-provider-node": "^3.972.83",
    "yaml": "^2.8.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.4",
    "@deepseek-ai/cosmokit": ">=1.8.5",
    "@deepseek-ai/dsh-credentials": ">=0.1.7-0",
    "@deepseek-ai/dsh-settings": ">=0.1.7-0",
    "@deepseek-ai/schemastery": ">=3.18.4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "link:../deepseek-harness/vendor/cordis",
    "@deepseek-ai/cosmokit": "link:../deepseek-harness/vendor/cosmokit",
    "@deepseek-ai/dsh-credentials": "link:../deepseek-harness/packages/credentials/credentials",
    "@deepseek-ai/dsh-settings": "link:../deepseek-harness/packages/settings/settings",
    "@deepseek-ai/schemastery": "link:../deepseek-harness/vendor/schemastery",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "esbuild": "^0.25.0",
    "react": "^19.2.0",
    "typescript": "^5.9.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jackchun53/dsh-oss-sync.git"
  },
  "publishConfig": {
    "access": "public"
  }
}
